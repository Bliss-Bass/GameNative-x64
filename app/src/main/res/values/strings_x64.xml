<resources>
    <string name="frame_present_mode">Frame presentation</string>
    <string name="frame_present_mode_performance">Performance</string>
    <string name="frame_present_mode_lean">Lean</string>
    <string name="frame_present_mode_balanced">Balanced</string>
    <string name="frame_present_mode_quality">Quality</string>
    <string name="frame_present_mode_performance_description">Hands each frame straight back to the game. Faster, but Intel GPUs may show black or torn frames, and some games can hang the GPU.</string>
    <string name="frame_present_mode_lean_description">Experimental. Like Balanced, but draws the screen at the game\'s resolution and lets Android scale it up. Saves GPU memory bandwidth on integrated GPUs; the cursor and overlays look softer.</string>
    <string name="frame_present_mode_balanced_description">Keeps each frame safe like Quality, but waits for it on the GPU and in the background instead of stalling the game.</string>
    <string name="frame_present_mode_quality_description">Waits for each frame to finish drawing and leave the screen. Fixes black or torn frames on Intel GPUs, but can halve the frame rate.</string>
    <string name="extra_debug_logging">Extra debug logging</string>
    <string name="extra_debug_logging_description">For troubleshooting only. Logs Wine exceptions and modules, Proton, DXVK and Mesa output, and game console output to logcat. Games run slower while this is on.</string>
    <string name="settings_performance_presentation_title">Frame presentation</string>
    <string name="present_auto">Automatic</string>
    <string name="present_auto_summary">Direct (DRI3) for every game. A game whose frames Direct cannot show switches to Software copy on its next launch.</string>
    <string name="present_auto_fell_back">Direct presentation failed for this game. It will use Software copy from its next launch.</string>
    <string name="present_software">Software copy</string>
    <string name="present_software_summary">Every frame is copied to the CPU and sent over the X socket. Slowest, but always works.</string>
    <string name="present_shm">Shared memory</string>
    <string name="present_shm_summary">Still copied to the CPU, but handed over in shared memory instead of the socket.</string>
    <string name="present_dri3">Direct (DRI3)</string>
    <string name="present_dri3_summary">GPU zero-copy when the dma-buf imports as AHB/Vulkan; LINEAR CPU upload is the fallback. Enable Native Rendering+ for AHB SurfaceControl scanout.</string>
